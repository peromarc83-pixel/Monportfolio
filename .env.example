# Fonction serverless netlify/functions/contact.js — à définir dans Netlify (Site
# configuration > Environment variables), jamais commitées dans le repo.
#
# Transport : Gmail (SMTP_USER = marc.pero.dev@gmail.com, même adresse que
# celle affichée sur le site, avec un mot de passe d'application —
# https://myaccount.google.com/apppasswords, pas le mot de passe du compte).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=
CONTACT_TO=votre-adresse@gmail.com
